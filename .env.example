# Browser transport is same-origin and points to the Next.js BFF.
NEXT_PUBLIC_API_BASE_URL=/api/proxy

# BFF → versioned API target. In local development, this app hosts both layers.
# Set the production value to this deployment's origin unless Core is deployed separately.
CORE_API_URL=http://localhost:3000
CORE_API_KEY=replace-with-a-long-random-server-secret

# Server-only Supabase configuration. Use the anon key; never use service_role.
SUPABASE_URL=
SUPABASE_ANON_KEY=

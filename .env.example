# Browser-safe Supabase project settings. Use the public anon or publishable key.
# Never put a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Alternative to NEXT_PUBLIC_SUPABASE_ANON_KEY for projects using the newer key name:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
